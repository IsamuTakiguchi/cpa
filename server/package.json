{
  "name": "@cpa/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@cpa/shared=../shared/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@cpa/shared": "*",
    "@hono/node-server": "^1.19.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0"
  }
}
