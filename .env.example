# Railway では DATABASE_URL は Postgres サービスから自動注入されます（Variables で ${{Postgres.DATABASE_URL}} を参照）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cpa
# セッションCookie署名用の長いランダム文字列（例: openssl rand -hex 32）
SESSION_SECRET=change-me-to-a-long-random-string
# 新規登録に必要な招待コード（本人だけが知る値にする）
SIGNUP_CODE=change-me
# Claude API キー（AI採点・まとめ生成に使用。未設定ならAI機能は無効表示）
ANTHROPIC_API_KEY=
# AI採点に使うモデルID（省略時は claude-sonnet-5）
AI_MODEL=claude-sonnet-5
# 1ユーザー・1日あたりのAI呼び出し上限
AI_DAILY_LIMIT=40
# サーバー内スナップショット(pg_dump)の保存先と世代数
BACKUP_DIR=/data/backups
BACKUP_KEEP=30
# 本番では true（HTTPS 前提の Secure Cookie）。ローカル開発では false
COOKIE_SECURE=false
PORT=3000
# Google ログイン（任意）。Google Cloud Console の OAuth クライアント ID/シークレット。両方設定すると有効
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google ログインで新規作成を許可するメールアドレス（カンマ区切り）。空なら最初のユーザーのみ作成可
ALLOWED_EMAILS=
# 公開 URL（省略時はリクエストの Host から判定）
PUBLIC_URL=
